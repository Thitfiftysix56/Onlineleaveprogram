NODE_ENV=development
PORT=8082

CORS_ORIGINS=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=online_leave_system
DB_USER=root
DB_PASSWORD=your_database_password

DB_CONNECTION_LIMIT=10

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

COOKIE_SECURE=false

PASSWORD_RESET_OTP_SECRET=replace_with_a_separate_long_random_secret
PASSWORD_RESET_OTP_TTL_MINUTES=5
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_RESEND_SECONDS=60
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Online Leave Approval System <no-reply@organization.local>
FRONTEND_URL=http://localhost:5173
