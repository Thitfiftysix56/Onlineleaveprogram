<mxfile host="app.diagrams.net" modified="2026-08-14T00:00:00.000Z" agent="Codex" version="24.7.17"><diagram id="dfd0" name="DFD Level 0"><mxGraphModel dx="2400" dy="1697" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1697" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="10" value="พนักงาน (Employee)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334e68;strokeWidth=2;fontFamily=Tahoma;fontSize=21;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="230" width="390" height="105" as="geometry" /></mxCell><mxCell id="11" value="หัวหน้างาน (Supervisor)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334e68;strokeWidth=2;fontFamily=Tahoma;fontSize=21;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="1190" width="390" height="105" as="geometry" /></mxCell><mxCell id="12" value="ฝ่ายทรัพยากรบุคคล (HR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334e68;strokeWidth=2;fontFamily=Tahoma;fontSize=21;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1940" y="230" width="390" height="105" as="geometry" /></mxCell><mxCell id="13" value="ผู้ดูแลระบบ (Admin)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334e68;strokeWidth=2;fontFamily=Tahoma;fontSize=21;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1940" y="1190" width="390" height="105" as="geometry" /></mxCell><mxCell id="14" value="บริการอีเมล (Email Service)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334e68;strokeWidth=2;fontFamily=Tahoma;fontSize=21;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1005" y="1480" width="390" height="105" as="geometry" /></mxCell><mxCell id="20" value="กระบวนการ 0 ระบบอนุมัติใบลาออนไลน์ (Online Leave Approval System)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e7f0fa;strokeColor=#2367a6;strokeWidth=3;fontFamily=Tahoma;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="650" width="600" height="360" as="geometry" /></mxCell><mxCell id="30" value="ข้อมูลจากพนักงานเข้าสู่ระบบ&#10;ข้อมูลเข้าสู่ระบบ&#10;ข้อมูลคำขอลา&#10;เอกสารประกอบการลา&#10;ข้อมูลยกเลิกคำขอลา&#10;ข้อมูลโปรไฟล์&#10;ข้อมูลเปลี่ยน/รีเซ็ตรหัสผ่าน&#10;คำขอตรวจสอบวันลาคงเหลือ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#36556f;strokeWidth=2;fontFamily=Tahoma;fontSize=16;" edge="1" parent="1" source="10" target="20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="31" value="ข้อมูลจากระบบถึงพนักงาน&#10;ผลการยืนยันตัวตน&#10;สถานะและประวัติคำขอลา&#10;ข้อมูลวันลาคงเหลือ&#10;ผลการบันทึก/ส่ง/ยกเลิกคำขอลา&#10;การแจ้งเตือนผลอนุมัติหรือปฏิเสธ&#10;ผลการจัดการข้อมูลส่วนตัวและรหัสผ่าน" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#36556f;strokeWidth=2;fontFamily=Tahoma;fontSize=16;" edge="1" parent="1" source="20" target="10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="32" value="ข้อมูลจากหัวหน้างานเข้าสู่ระบบ&#10;ข้อมูลเข้าสู่ระบบ&#10;ข้อมูลการอนุมัติคำขอลา&#10;ข้อมูลการปฏิเสธคำขอลา&#10;เงื่อนไข/ตัวกรองรายงานลูกทีม" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#36556f;strokeWidth=2;fontFamily=Tahoma;fontSize=16;" edge="1" parent="1" source="11" target="20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="33" value="ข้อมูลจากระบบถึงหัวหน้างาน&#10;ผลการยืนยันตัวตน&#10;ข้อมูลคำขอลาที่รอพิจารณา&#10;รายละเอียดคำขอลาและเอกสารประกอบ&#10;ผลการอนุมัติหรือปฏิเสธ&#10;การแจ้งเตือนคำขอลาใหม่&#10;ข้อมูลรายงานการลาของลูกทีม" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#36556f;strokeWidth=2;fontFamily=Tahoma;fontSize=16;" edge="1" parent="1" source="20" target="11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="34" value="ข้อมูลจากฝ่ายทรัพยากรบุคคลเข้าสู่ระบบ&#10;ข้อมูลพนักงาน&#10;ข้อมูลหัวหน้างานของพนักงาน&#10;ข้อมูลประเภทการลา&#10;ข้อมูลสิทธิ์การลา&#10;ข้อมูลวันหยุดองค์กร&#10;เงื่อนไขการออกรายงาน" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#36556f;strokeWidth=2;fontFamily=Tahoma;fontSize=16;" edge="1" parent="1" source="12" target="20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="35" value="ข้อมูลจากระบบถึงฝ่ายทรัพยากรบุคคล&#10;ผลการจัดการข้อมูลพนักงาน&#10;ข้อมูลประเภทการลา&#10;ข้อมูลสิทธิ์การลา&#10;ข้อมูลวันหยุดองค์กร&#10;ข้อมูลรายงานการลา&#10;ไฟล์รายงาน Excel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#36556f;strokeWidth=2;fontFamily=Tahoma;fontSize=16;" edge="1" parent="1" source="20" target="12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="36" value="ข้อมูลจากผู้ดูแลระบบเข้าสู่ระบบ&#10;ข้อมูลบัญชีผู้ใช้งาน&#10;ข้อมูล Role/สถานะบัญชี&#10;ข้อมูลแผนก&#10;ข้อมูลตำแหน่ง&#10;เงื่อนไขค้นหา Audit Log&#10;ข้อมูล Reset Password ของผู้ใช้งาน" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#36556f;strokeWidth=2;fontFamily=Tahoma;fontSize=16;" edge="1" parent="1" source="13" target="20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="37" value="ข้อมูลจากระบบถึงผู้ดูแลระบบ&#10;ผลการจัดการบัญชีผู้ใช้งาน&#10;Temporary Password&#10;ข้อมูลแผนก&#10;ข้อมูลตำแหน่ง&#10;ข้อมูล Audit Log" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#36556f;strokeWidth=2;fontFamily=Tahoma;fontSize=16;" edge="1" parent="1" source="20" target="13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="38" value="ข้อมูลถึงบริการอีเมล&#10;ข้อมูลผู้รับอีเมลและ OTP" style="edgeStyle=orthogonal